    must(not os.path.exists(os.path.join(root, "var/instances/work/sealed.box")), "a bad client file still sealed")
    code, all_text = drive(root, ["login", "--provider", "gmail", "--client", gmail_client(root), "work"], [], 20)
    must(code == 0, "login --provider gmail exit %s\n%s" % (code, all_text))
    must("Sealed. The door is shut." in all_text, "cli gmail sign-in did not seal")
    inst = os.path.join(root, "var/instances/work")
    must(open(os.path.join(inst, "provider")).read().strip() == "gmail", "cli sign-in did not record gmail")
    must(os.path.isfile(os.path.join(inst, "sealed.box")), "cli sign-in sealed nothing")
    code, all_text = drive(root, ["login", "--provider", "nope", "other"], [], 10)
    must(code == 1 and "provider must be hey or gmail" in all_text, "a bad provider was not refused")
    code, all_text = drive(root, ["run", "work", "--", "setup"], [], 10)
    must(code == 1 and "refused" in all_text, "gmail setup was not refused")
    code, all_text = drive(root, ["run", "work", "--", "contact", "list"], [], 10)
    must(code == 1 and "refused" in all_text, "gmail contact list was not refused")
    code, all_text = drive(root, ["run", "work", "--", "auth", "login"], [], 10)
    must(code == 1 and "refused" in all_text, "gmail auth login was not refused")
    code, all_text = drive(root, ["run", "work", "--", "version"], [], 10)
    must(code == 0 and "gmail version stub" in all_text, "gmail version failed: " + all_text)
    # A hey instance beside it still says hey.
    must(not os.path.exists(os.path.join(root, "var/instances/other")), "a refused login made an instance")

def gmail_export(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-gmail"
    os.makedirs(home, 0o700)
    os.environ["HOME"] = home
    os.environ["FINGERONIT_NO_OPEN"] = "1"
    args = ["export", "--with", "news@example.com", "--days", "14", "--md"]
    md = os.path.join(home, "fingeronit-export/news-example.com/to-and-from-past-14-days.md")
    att = os.path.join(home, "fingeronit-export/news-example.com/attachments/18c0a1b2c3d4e5f0/note.txt")
    keep = {}
    def grab(root, sl):
        keep["text"] = open(md, encoding="utf-8").read()
        keep["att"] = os.path.isfile(att)
        logp = os.path.join(root, "var/stub-gmail.log")
        keep["log"] = open(logp, encoding="utf-8").read() if os.path.isfile(logp) else ""
    steps = [{"wait": "d   done", "check": grab, "send": "d"}, {"wait": "Deleted"}]
    code, all_text = drive(root, args, steps, 30)
    must(code == 0, "gmail export exit %s\n%s" % (code, all_text))
    must("Asking Gmail for mail to and from news@example.com" in all_text, "export did not say Gmail")
    must("Found 5:" in all_text, "gmail to-and-from did not find 5\n" + all_text)
    must("Exported 5 threads." in all_text, "gmail export count missing")
    must("Gmail mentioned" in keep["text"], "a thread that only names the address was missed")
    text = keep["text"]
    for want in ("stub-gmail-thread 18c0a1b2c3d4e5f0", "stub-gmail-thread 18c0a1b2c3d4e5f1",
                 "stub-gmail-thread 18c0a1b2c3d4e5f2"):
        must(want in text, "gmail export missed " + want)
    must(text.count("stub-gmail-thread 18c0a1b2c3d4e5f0") == 1, "a thread found twice was written twice")
    must("Gmail ancient" not in text, "gmail export ignored the days window")
    must("## [draft] Gmail draft" in text and "Draft, not sent." in text, "the gmail draft is missing")
    must("To: news@example.com" in text and "Bcc: hidden@example.org" in text, "the gmail draft's recipients are missing")
    must("stub-gmail-draft-body" in text, "the gmail draft body is missing")
    must("Other gmail draft" not in text, "a draft to someone else was exported")
    must(keep["att"], "the gmail attachment was not saved")
    log = keep["log"]
    must("search --from news@example.com" in log, "gmail search was not recorded: " + log)
    must("draft show r-1234abcd" in log, "the string draft id was not used")
    must("contact" not in log, "a HEY-only contact step ran for gmail")
    must("hey-stub" not in all_text, "hey ran for a gmail instance")
    log2 = open(os.path.join(root, "var/instances/temp/audit.log"), encoding="utf-8").read()
    must("mode=all" in log2, "the gmail export was not audited")
    must(not live_lock(root) and not live_cred(root), "gmail export left the door open")

def gmail_session(root):
    # Inside a gmail session, the keeper itself refuses what gmail may not do.
    R = root
    env = ("FINGERONIT_KEEPER_HOME=%s/var/live/keeper FINGERONIT_KEEPER_HEY=%s/libexec/hey "
           "FINGERONIT_KEEPER_GMAIL=%s/lib/providers/gmail.py FINGERONIT_KEEPER_SEAL=%s/bin/finger-seal" % (R, R, R, R))
    def k(argv, tag):
        return 'printf "%%s\\n" "$__hb_t" | %s /bin/bash %s/lib/keeper run -- %s; echo %s=$?\n' % (env, R, argv, tag)
    steps = [
        {"wait": "Choose:", "send": "3"},
        {"wait": "Session temp is open", "send": k("contact list", "KA")},
        {"wait": "KA=77", "check": lambda root, sl: must("refused" in sl, "keeper ran contact for gmail: " + sl),
         "send": k("draft delete r-1234abcd", "KB")},
        {"wait": "KB=77", "send": k("auth login", "KC")},
        {"wait": "KC=77", "send": k("tui", "KD")},
        {"wait": "KD=77", "send": k("version", "KE")},
        {"wait": "KE=0", "check": lambda root, sl: must("gmail version stub" in sl, "keeper did not run gmail version"),
         "send": "gmail contact list\n"},
        {"wait": "refused. setup, skills, mcp", "send": "gmail search --help\n"},
        {"wait": "--all", "send": "exit\n"},
        {"wait": "Choose:", "check": assert_session, "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 40)
    must(code == 0, "gmail session exit %s" % code)

GOOD = ["--purpose", "Find the alpha note News sent me last week", "--from", "news@example.com",
        "--about", "alpha", "--days", "30"]

def ask_cmd(root, *args, wait=True, stdin=None):
    import subprocess
    p = subprocess.Popen([os.path.join(root, "fingeronit"), "ask", *args],
                         stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    if not wait:
        return p
    out, err = p.communicate(input=stdin.encode() if stdin is not None else None, timeout=30)
    return p.returncode, out.decode(), err.decode()

def desk(root):
    import json
    ddir = os.environ["FINGERONIT_DESK_DIR"]
    # No desk open: the agent is told to ask its human, nothing waits.
    code, out, _ = ask_cmd(root, *GOOD)
    must(code == 75 and "no desk is open" in out, "ask without a desk: %s %s" % (code, out))
    # Shapes that are refused before anyone is asked.
    refused = [
        (["--purpose", "Show me all emails ever sent to me", "--from", "news@example.com",
          "--about", "alpha", "--days", "30"], "asks for too much"),
        (["--purpose", "Find the alpha note News sent me", "--from", "*@example.com",
          "--about", "alpha", "--days", "30"], "full email address"),
        (["--purpose", "Find the alpha note News sent me", "--from", "example.com",
          "--about", "alpha", "--days", "30"], "full email address"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--days", "30"], "say what it is about"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "all subjects", "--days", "30"], "says nothing about the topic"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "alpha"], "--days N is required"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "alpha", "--days", "3000"], "--days must be 1 to 90"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "alpha", "--days", "30", "--max", "50"], "--max must be 1 to 5"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "in:anywhere", "--days", "30"], "plain word"),
        (["--purpose", "Find the alpha note News sent me", "--from", "news@example.com",
          "--about", "alpha OR beta", "--days", "30"], "no search operators"),
        (GOOD + ["--", "box", "list"], "unknown flag"),
        (["--purpose", "short", "--from", "news@example.com", "--about", "alpha", "--days", "30"],
         "too short"),
    ]
    for args, why in refused:
        code, out, _ = ask_cmd(root, *args)
        must(code == 2 and why in out, "ask was not refused for %r: %s %s" % (why, code, out))
    many = GOOD + ["--then"] + GOOD[2:5] + ["beta", "--days", "9", "--then"] + GOOD[2:5] + \
        ["gamma", "--days", "8", "--then"] + GOOD[2:5] + ["delta", "--days", "7"]
    code, out, _ = ask_cmd(root, *many)
    must(code == 2 and "3 lookups at most" in out, "four lookups were allowed: %s" % out)
    code, out, _ = ask_cmd(root, "--json", stdin='{"purpose": "Find the alpha note News sent me", '
                           '"lookups": [{"from": "news@example.com", "about": "alpha", "days": 30, '
                           '"command": "box list"}]}')
    must(code == 2 and "unknown field command" in out, "an extra JSON field was allowed: %s" % out)
    code, out, _ = ask_cmd(root, "--check", *GOOD)
    must(code == 0 and "Your human would read" in out and "news@example.com" in out,
         "ask --check: %s %s" % (code, out))
    must(not os.path.exists(os.path.join(ddir, "in")), "--check queued something")

    state = {}
    def waiting(root, slice_):
        must("only you can approve" in slice_ or "Waiting for agent requests" in slice_, "desk banner missing")
        must(not live_lock(root), "the desk opened the door before a request")
        state["p"] = ask_cmd(root, *(GOOD + ["--max", "2", "--read"]), wait=False)
    def shown(root, slice_):
        must("An agent asks:" in slice_, "the request was not shown")
        must("Find the alpha note News sent me" in slice_, "the purpose was not shown")
        must('mail from news@example.com about "alpha", last 30 days, up to 2 threads' in slice_,
             "the lookup was not shown: " + slice_)
        must(not live_lock(root), "the door opened before approval")
    def reviewed(root, slice_):
        must("Touch ID code " in slice_, "no Touch ID code was shown")
        must("The door is shut again." in slice_, "the door was not shut before review")
        must(not live_lock(root) and not live_cred(root), "the door was open during review")
        must("Alpha note" in slice_, "the matching thread was not shown")
        for other in ("Beta note", "Gamma note", "Ancient note"):
            must(other not in slice_, other + " was in the results")
    def sent(root, slice_):
        p = state["p"]
        out, err = p.communicate(timeout=20)
        must(p.returncode == 0, "ask exit %s: %s %s" % (p.returncode, out, err))
        text = out.decode()
        ans = json.loads(text)
        threads = ans["lookups"][0]["threads"]
        must([t["id"] for t in threads] == ["111"], "wrong threads went out: %s" % threads)
        must("stub-thread 111" in threads[0]["text"], "the text did not go out")
        must("SECRET-BODY" not in text, "search snippets went out")
        must(not os.listdir(os.path.join(ddir, "out")), "the answer was left behind")
        log = open(os.path.join(root, "var/instances/temp/audit.log")).read()
        must("desk approved" in log and "desk sent" in log, "the desk did not audit")
        state["p"] = ask_cmd(root, *(GOOD[:5] + ["beta", "--days", "30"]), wait=False)
    def said_no(root, slice_):
        p = state["p"]
        out, _ = p.communicate(timeout=20)
        must(p.returncode == 3 and "said no" in out.decode(), "a no was not passed on: %s" % out)
        state["p"] = ask_cmd(root, *GOOD, wait=False)
    def kept(root, slice_):
        p = state["p"]
        out, _ = p.communicate(timeout=20)
        must(p.returncode == 3 and "kept them" in out.decode(), "kept results went out: %s" % out)
    steps = [
        {"wait": "Waiting for agent requests", "check": waiting},
        {"wait": "Approve with Touch ID? [y/N] ", "check": shown, "send": "y\r"},
        {"wait": "Send this to the agent? [y/N] ", "check": reviewed, "send": "y\r"},
        {"wait": "Sent."},
        {"wait": "Waiting for agent requests", "check": sent},
        {"wait": "Approve with Touch ID? [y/N] ", "send": "n\r"},
        {"wait": "Said no."},
        {"wait": "Waiting for agent requests", "check": said_no},
        {"wait": "Approve with Touch ID? [y/N] ", "send": "y\r"},
        {"wait": "Send this to the agent? [y/N] ", "send": "\r"},
        {"wait": "Kept. The agent got nothing."},
        {"wait": "Waiting for agent requests", "check": kept, "send": "q"},
        {"wait": "Desk closed."},
    ]
    code, text = drive(root, ["desk"], steps, 60)
    must(code == 0, "desk exit %s" % code)
    must(not live_lock(root) and seal(root), "the desk left the door open or lost the seal")
    must(not os.path.exists(os.path.join(ddir, "desk.pid")), "the desk left its pid behind")
    code, out, _ = ask_cmd(root, *GOOD)
    must(code == 75, "ask after the desk closed: %s" % code)

if __name__ == "__main__":
    root, name = sys.argv[1], sys.argv[2]
    {"story": story, "signin": signin, "already": already, "setup": setup_refused,
     "version": version_cmd, "stale": stale, "other": other,
     "export": export_pick, "export-all": export_all, "inside": inside,
     "autopilot": autopilot, "nobody": nobody, "two": two_senders,
     "idle-session": idle_session, "idle-picker": idle_picker, "crash": crash,
     "farewell": farewell_menu, "clean-old": clean_old, "with": with_mail, "prompts": prompts,
     "hangup": hangup, "orphaned": orphaned, "owned-elsewhere": owned_elsewhere,
     "signin-gmail": signin_gmail, "login-cli": login_cli, "gmail-export": gmail_export,
     "gmail-session": gmail_session, "desk": desk}[name](root)
PY
  chmod 700 "$1"
}

pass() { printf 'pass  %s\n' "$1"; }

