def hangup(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-hup"
    os.makedirs(home, 0o700)
    os.environ["HOME"] = home
    os.environ["FINGERONIT_NO_OPEN"] = "1"
    steps = [
        {"wait": "Choose:", "send": "1"},
        {"wait": "Address (", "send": "news@example.com\n"},
        {"wait": "with drafts] [1]:", "send": "\n"},
        {"wait": "Days back", "send": "\n"},
        {"wait": "File [", "send": "1\n"},
        {"wait": "Folder [", "send": "\n"},
        {"wait": "q cancels", "send": "a"},
        {"wait": "3 selected", "send": "\n"},
        {"wait": "Any other key for the menu.", "check": lambda root, sl: must(
            os.path.isdir(os.path.join(home, "fingeronit-export")), "the export was not written"), "hangup": True},
    ]
    drive(root, [], steps, 40)
    deadline = time.time() + 10
    while time.time() < deadline and os.path.exists(os.path.join(home, "fingeronit-export")):
        time.sleep(0.2)
    must(not os.path.exists(os.path.join(home, "fingeronit-export")), "a hung-up terminal left the exports behind")
    must(not live_lock(root) and not live_cred(root), "a hung-up terminal left the door open")
    must(seal(root), "the seal was lost when the terminal hung up")

def orphaned(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-orphan"
    exp = os.path.join(home, "fingeronit-export", "left")
    os.makedirs(exp)
    os.environ["HOME"] = home
    open(os.path.join(exp, "left.md"), "w").write("left by a killed fingeronit\n")
    # An owner that is gone: a pid that is not running.
    open(os.path.join(home, "fingeronit-export", ".fingeronit-owner"), "w").write("99999999 Thu Jan  1 00:00:00 2026\n")
    steps = [
        {"wait": "Choose:", "check": lambda root, sl: (
            must("did not close" in sl, "exports from a killed fingeronit were not flagged"),
            must("1 exported files wait" in sl, "the owner file was counted as an export"),
        ), "send": "q"},
        {"wait": "d   done", "send": "d"},
        {"wait": "Deleted"},
    ]
    drive(root, [], steps, 30)
    must(not os.path.exists(os.path.join(home, "fingeronit-export")), "adopted exports survived the farewell")

def owned_elsewhere(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-other"
    exp = os.path.join(home, "fingeronit-export", "theirs")
    os.makedirs(exp)
    os.environ["HOME"] = home
    open(os.path.join(exp, "theirs.md"), "w").write("another terminal's export\n")
    other = subprocess.Popen(["/bin/bash", "-c", "exec -a fingeronit-other-terminal sleep 60"])
    try:
        time.sleep(0.3)
        started = subprocess.run(["ps", "-o", "lstart=", "-p", str(other.pid)], capture_output=True, text=True).stdout.strip()
        open(os.path.join(home, "fingeronit-export", ".fingeronit-owner"), "w").write("%d %s\n" % (other.pid, started))
        steps = [
            {"wait": "Choose:", "check": lambda root, sl: must(
                "belong to a fingeronit in another terminal" in sl, "another terminal's exports were not recognised"), "send": "q"},
        ]
        code, all_text = drive(root, [], steps, 30)
        must(code == 0, "owned-elsewhere exit %s" % code)
        must("Left them for it." in all_text, "quitting did not say it left them")
        must(os.path.isfile(os.path.join(exp, "theirs.md")), "quitting deleted another terminal's exports")
    finally:
        other.kill()
        other.wait()

def with_mail(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-with"
    os.makedirs(home, 0o700)
    os.environ["HOME"] = home
    os.environ["FINGERONIT_NO_OPEN"] = "1"
    args = ["export", "--with", "news@example.com", "--days", "14", "--md"]
    md = os.path.join(home, "fingeronit-export/news-example.com/to-and-from-past-14-days.md")
    keep = {}
    def grab(root, sl):
        keep["text"] = open(md, encoding="utf-8").read()
    steps = [{"wait": "d   done", "check": grab, "send": "d"}, {"wait": "Deleted"}]
    code, all_text = drive(root, args, steps, 30)
    must(code == 0, "with exit %s\n%s" % (code, all_text))
    must("Found 6:" in all_text, "to-and-from did not find 6\n" + all_text)
    must("Exported 6 threads." in all_text, "to-and-from count missing")
    text = keep["text"]
    must("# Mail to and from news@example.com" in text, "to-and-from header missing")
    for want in ("stub-thread 111", "stub-thread 222", "stub-thread 555", "stub-thread 888", "stub-thread 999"):
        must(want in text, "to-and-from missed " + want)
    must(text.count("stub-thread 111") == 1, "a thread found three ways was written more than once")
    must("Old sent" not in text, "to-and-from ignored the days window")
    must("## [draft] Reply draft" in text and "Draft, not sent." in text, "the draft is missing")
    must("To: news@example.com" in text and "Bcc: hidden@example.org" in text, "the draft's recipients are missing")
    must("stub-draft-body" in text, "the draft's body is missing")
    must("Other draft" not in text, "a draft to someone else was exported")
    must("SECRET-BODY" not in text, "a listing summary leaked into the file")
    log = open(os.path.join(root, "var/instances/temp/audit.log"), encoding="utf-8").read()
    must("mode=all" in log, "the mode was not audited")


