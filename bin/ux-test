    steps = [
        {"wait": "Choose:", "check": lambda root, sl: (
            must("in another terminal" in sl, "other door not explained"),
            must("Open a shell session" not in sl, "session offered while another holds the door"),
            must("Sign in" not in sl, "sign-in offered while another holds the door"),
        ), "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 15)
    must(code == 0, "other exit %s" % code)
    must("Left the other door alone." in all_text, "quit touched the other door")
    must(live_lock(root), "quit removed someone else's lock")

def assert_inside_menu(root, slice_):
    must("Open in this session" in slice_, "inner fingeronit did not know its own session")
    must("open, this session" in slice_, "door label did not say this session")
    must("Run a hey command" in slice_, "run not offered inside")
    must("Export mail from a sender" in slice_, "export not offered inside")
    must("Open a shell session" not in slice_, "a nested session was offered")
    must("Destroy" not in slice_, "destroy offered while the session is open")
    must("in another terminal" not in slice_, "own session called a stranger")
    must("Back to the session" in slice_, "quit was not back-to-session")
    must(live_lock(root) and live_cred(root), "session door was not open")
    outsider_refused(root)

def assert_inside_run(root, slice_):
    must("hey-stub: box list" in slice_, "inside command did not run")
    must("still open" in slice_, "inside command did not say the session is open")
    must(live_lock(root) and live_cred(root), "inside command shut the session")

