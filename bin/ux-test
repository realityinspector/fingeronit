#!/bin/bash
# Replay the menu against a fake login in /tmp.
# This never opens a real seal, or any mail.
set -euo pipefail
set +m
umask 077

HERE="$(cd "$(dirname "$0")" && pwd)"
SRC="$HERE/fingeronit"
KEEPER_SRC="$HERE/../lib/keeper"
[[ -f "$SRC" ]] || { printf 'ux-test: bin/fingeronit is missing\n' >&2; exit 1; }
[[ -f "$KEEPER_SRC" ]] || { printf 'ux-test: lib/keeper is missing\n' >&2; exit 1; }

# Never your real home: exports, ~/.config/hey-cli, and the keychain are faked.
UXHOME="$(mktemp -d /tmp/fingeronit-ux-home.XXXXXX)"
case "$UXHOME" in /tmp/fingeronit-ux-home.*) ;; *) exit 1 ;; esac
export HOME="$UXHOME"
export FINGERONIT_KEEPER_LOCAL=1
export FINGERONIT_SECURITY="$UXHOME/security-stub"
export FINGERONIT_DESK_DIR="$UXHOME/desk"
cat > "$FINGERONIT_SECURITY" << EOF
#!/bin/bash
# Stub keychain. The marker file stands for one item under service "hey".
m="$UXHOME/kc-hey"
case "\${1:-}" in
  find-generic-password) [[ -f "\$m" ]] && exit 0; exit 44 ;;
  delete-generic-password) [[ -f "\$m" ]] || exit 44; rm -f "\$m"; printf 'delete\n' >> "$UXHOME/kc-log"; exit 0 ;;
  dump-keychain)
    if [[ -f "\$m" ]]; then
      printf 'keychain: "/stub"\nattributes:\n    "acct"<blob>="https://app.hey.com"\n    "svce"<blob>="hey"\n'
    fi
    exit 0 ;;
esac
exit 1
EOF
chmod 700 "$FINGERONIT_SECURITY"

ROOTS=()
SLEEPERS=()

cleanup() {
  local pid root
  for pid in "${SLEEPERS[@]+"${SLEEPERS[@]}"}"; do
    kill "$pid" 2>/dev/null || true
  done
  for root in "${ROOTS[@]+"${ROOTS[@]}"}"; do
    case "$root" in
      /tmp/fingeronit-ux.*) python3 -c 'import shutil,sys; shutil.rmtree(sys.argv[1], ignore_errors=True)' "$root" ;;
    esac
  done
  case "${UXHOME:-}" in
    /tmp/fingeronit-ux-home.*) python3 -c 'import shutil,sys; shutil.rmtree(sys.argv[1], ignore_errors=True)' "$UXHOME" ;;
  esac
  python3 -c 'import glob,shutil
for path in glob.glob("/tmp/fingeronit-export.fingeronit-ux.*"):
    shutil.rmtree(path, ignore_errors=True)'
}
trap cleanup EXIT

write_stubs() {
  local root="$1"
  cat > "$root/bin/finger-touch" << EOF
#!/bin/bash
set -euo pipefail
root="$root"
marker() { printf '%s/var/keys/%s' "\$root" "\${1//\\//_}"; }
cmd="\${1:-}"
shift || true
case "\$cmd" in
  status)
    if [[ -f "\$(marker "\$1")" ]]; then printf 'present\n'; else printf 'absent\n'; fi
    ;;
  seal)
    mkdir -p "\$(dirname "\$3")" "\$(dirname "\$(marker "\$1")")"
    { printf 'FINGER1\\0'; cat "\$2"; } > "\$3"
    : > "\$(marker "\$1")"
    ;;
  unseal)
    mkdir -p "\$(dirname "\$3")" "\$(dirname "\$4")"
    [[ "\$(head -c 7 "\$2")" == FINGER1 ]] || { printf 'stub: not a seal\n' >&2; exit 65; }
    tail -c +9 "\$2" > "\$3"
    dd if=/dev/zero of="\$4" bs=32 count=1 2>/dev/null
    ;;
  streams)
    exit 0
    ;;
  unseal-stream)
    [[ "\$(head -c 7 "\$2")" == FINGER1 ]] || { printf 'stub: not a seal\n' >&2; exit 65; }
    printf '%064d\n' 0
    tail -c +9 "\$2"
    ;;
  seal-raw)
    mkdir -p "\$(dirname "\$3")"
    cp "\$2" "\$3"
    ;;
  drop)
    for account in "\$@"; do
      [[ "\$account" == "--" ]] && break
      rm -f "\$(marker "\$account")"
    done
    ;;
  *)
    printf 'finger-touch stub: %s\n' "\$cmd" >&2
    exit 1
    ;;
esac
EOF
  cat > "$root/libexec/hey" << 'EOF'
#!/bin/bash
set -euo pipefail
if [[ -n "${TMPDIR:-}" ]]; then
  printf '%s\n' "$*" >> "$TMPDIR/invocations.log"
fi
if [[ "${1:-}" == "auth" && "${2:-}" == "login" ]]; then
  mkdir -p "$XDG_CONFIG_HOME/hey-cli"
  printf '%s\n' '{"origin":"test"}' > "$XDG_CONFIG_HOME/hey-cli/credentials.json"
  printf 'Logged in (stub)\n'
  exit 0
fi
case " $* " in
  *" --help "*)
    case "${1:-} ${2:-}" in
      "search "*) printf 'Flags:\n  --from string\n  --to string\n  --date string\n  --all\nGlobal Flags:\n  --json\n' ;;
      "thread read") printf 'Flags:\n  --markdown\n' ;;
      "attachment list") printf 'Flags:\n  --allow-partial\nGlobal Flags:\n  --json\n' ;;
      "attachment save") printf 'Flags:\n  -o, --output string\n  --force\n' ;;
      *) printf 'usage\n' ;;
    esac
    exit 0
    ;;
esac
if [[ "${1:-}" == "version" ]]; then
  printf 'hey version stub\n'
  exit 0
fi
if [[ "${1:-}" == "search" ]]; then
  case " $* " in *" --json "*) ;; *) printf 'stub: search wants --json\n' >&2; exit 2 ;; esac
  from="" to="" query=""
  prev=""
  for arg in "$@"; do
    case "$prev" in
      --from) from="$arg" ;;
      --to) to="$arg" ;;
      --date|--page) ;;
      *) [[ "$arg" != -* && "$arg" != search && -z "$query" ]] && query="$arg" ;;
    esac
    prev="$arg"
  done
  python3 - "$from" "$to" "$query" << 'PY2'
import json, sys
from datetime import datetime, timedelta, timezone
now = datetime.now(timezone(timedelta(hours=-7)))
def go(days):
    # Go's RFC3339Nano: nine fractional digits and a numeric offset
    return (now - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S.123456789-07:00")
def row(tid, subject, days, with_messages=True, creator=None):
    r = {"id": 9000 + tid, "topic_id": tid, "subject": subject, "updated_at": go(days)}
    msg = {"id": tid * 10, "created_at": go(days), "summary": "SECRET-BODY " + subject}
    if creator:
        msg["creator"] = creator
    r["messages"] = [msg] if with_messages else []
    return r
data = []
if sys.argv[2] == "news@example.com":
    data = [row(888, "Sent reply", 4), row(889, "Old sent", 40)]
elif sys.argv[3] == "news@example.com":
    data = [row(111, "Alpha note", 3), row(999, "Mentioned", 6)]
elif sys.argv[1] == "news@example.com":
    newsc = {"id": 42, "name": "News", "email_address": "News@example.com"}
    data = [row(111, "Alpha note", 3, creator=newsc), row(222, "Beta note", 10, False),
            row(333, "Gamma note", 20), row(444, "Ancient note", 40)]
elif sys.argv[1] == "first@example.com":
    data = [row(501, "First recent", 2), row(777, "Shared thread", 5), row(502, "First ancient", 400)]
elif sys.argv[1] == "second@example.org":
    data = [row(601, "Second only", 30), row(777, "Shared thread", 5)]
json.dump({"ok": True, "data": data, "summary": "%d results" % len(data),
           "meta": {"page": 1, "pages_fetched": 1}}, sys.stdout)
sys.stdout.write("\n")
PY2
  exit 0
fi
if [[ "${1:-}" == "draft" && "${2:-}" == "list" ]]; then
  case " $* " in *" --all "*) ;; *) printf 'stub: draft list wants --all\n' >&2; exit 2 ;; esac
  printf '{"ok":true,"data":[{"id":31,"subject":"Reply draft","summary":"SECRET-BODY draft","updated_at":"%s","addressed_contacts":[{"id":42,"email_address":"news@example.com"}]},{"id":32,"subject":"Other draft","updated_at":"%s","addressed_contacts":[{"id":9,"email_address":"someone@example.org"}]}]}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  exit 0
fi
if [[ "${1:-}" == "draft" && "${2:-}" == "show" ]]; then
  [[ "${3:-}" == 31 ]] || { printf 'stub: no such draft\n' >&2; exit 1; }
  printf '{"ok":true,"data":{"id":31,"subject":"Reply draft","from":"me@example.com","to":["news@example.com"],"bcc":["hidden@example.org"],"body":"stub-draft-body"}}\n'
  exit 0
fi
if [[ "${1:-}" == "contact" && "${2:-}" == "list" ]]; then
  printf '{"ok":true,"data":[{"id":77,"name":"First","email_address":"first@example.com"},{"id":78,"name":"Other","email_address":"other@example.com"}]}\n'
  exit 0
fi
if [[ "${1:-}" == "contact" && "${2:-}" == "threads" ]]; then
  case " $* " in *" --all "*) ;; *) printf 'stub: contact threads wants --all\n' >&2; exit 2 ;; esac
  case " $* " in *" --json "*) ;; *) printf 'stub: contact threads wants --json\n' >&2; exit 2 ;; esac
  python3 - "${3:-}" << 'PY3'
import json, sys
from datetime import datetime, timedelta, timezone
now = datetime.now(timezone(timedelta(hours=-7)))
def go(days):
    return (now - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S.123456789-07:00")
def post(tid, name, days):
    # updated_at is newer than active_at on purpose: active_at is the thread's date
    return {"id": 8000 + tid, "topic_id": tid, "name": name, "active_at": go(days),
            "updated_at": go(0), "summary": "SECRET-BODY " + name}
posts = {"42": [post(111, "Alpha note", 3), post(555, "Delta note", 12), post(666, "Contact old note", 90)],
         "77": [post(503, "First via contact", 1)]}.get(sys.argv[1])
if posts is None:
    sys.stderr.write("stub: no such contact\n")
    sys.exit(1)
json.dump({"ok": True, "data": {"id": int(sys.argv[1]), "postings": posts}}, sys.stdout)
sys.stdout.write("\n")
PY3
  exit 0
fi
if [[ "${1:-}" == "thread" && "${2:-}" == "read" ]]; then
  printf 'stub-thread %s\n' "${3:-}"
  exit 0
fi
if [[ "${1:-}" == "attachment" && "${2:-}" == "list" ]]; then
  case " $* " in *" --json "*) ;; *) printf 'stub: attachment list wants --json\n' >&2; exit 2 ;; esac
  t="${3:-}"
  printf '{"ok":true,"data":[{"id":"%s0:1","filename":"note.txt"},{"id":"%s1:1","filename":"note.txt"},{"id":"%s2:1","filename":"note.txt"}]}\n' "$t" "$t" "$t"
  exit 0
fi
if [[ "${1:-}" == "attachment" && "${2:-}" == "save" ]]; then
  out=""
  prev=""
  for arg in "$@"; do
    if [[ "$prev" == "--output" || "$prev" == "-o" ]]; then
      out="$arg"
    fi
    prev="$arg"
  done
  [[ -n "$out" ]] || exit 1
  mkdir -p "$out"
  if [[ -e "$out/note.txt" ]]; then
    printf '{"ok":false,"error":"destination already exists: %s (use --force to replace it)","code":"usage"}\n' "$out/note.txt" >&2
    exit 64
  fi
  case "${3:-}" in
    *2:1) printf 'stub-attachment, a different file\n' > "$out/note.txt" ;;
    *) printf 'stub-attachment\n' > "$out/note.txt" ;;
  esac
  exit 0
fi
printf 'hey-stub: %s\n' "$*"
exit 0
EOF
  cat > "$root/bin/finger-seal" << 'EOF'
#!/bin/bash
# Stub seal: the header, then the plaintext. The real one is AES-GCM.
[[ "${1:-}" == "--check" ]] && { cat > /dev/null; printf '1\n'; exit 0; }
[[ -f "${1:-}" ]] || exit 65
printf 'FINGER1\0'
cat
EOF
  cat > "$root/lib/providers/gmail.py" << 'EOF'
# Stub Gmail provider for ux-test: the interface lib/providers/gmail.py implements,
# with fixture data from example.com. It never touches the network.
import json, os, sys
from datetime import datetime, timedelta, timezone

args = sys.argv[1:]
# The test root's var/ outlives the door, so the test can read what was called.
with open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../var/stub-gmail.log"), "a") as log:
    log.write(" ".join(args) + "\n")

def out(obj):
    json.dump(obj, sys.stdout)
    sys.stdout.write("\n")

def stamp(days):
    return (datetime.now(timezone.utc) - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")

def flag(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else ""

if args[:2] == ["auth", "login"]:
    cfg = os.path.join(os.environ["XDG_CONFIG_HOME"], "fingeronit-gmail")
    os.makedirs(cfg, exist_ok=True)
    with open(os.path.join(cfg, "credentials.json"), "w") as f:
        f.write('{"origin":"test","provider":"gmail"}\n')
    print("Logged in (gmail stub)")
    sys.exit(0)
if args[:2] == ["auth", "status"]:
    out({"ok": True, "data": {"authenticated": True}})
    sys.exit(0)
if args[:1] == ["version"]:
    print("gmail version stub")
    sys.exit(0)
if "--help" in args:
    if args[0] == "search":
        print("Flags:\n  --from string\n  --to string\n  --date string\n  --all\n  --json")
    elif args[:2] == ["thread", "read"]:
        print("Flags:\n  --markdown")
    elif args[:2] == ["attachment", "list"]:
        print("Flags:\n  --json")
    elif args[:2] == ["attachment", "save"]:
        print("Flags:\n  --output string\n  --force")
    else:
        print("usage")
    sys.exit(0)

def thread(tid, subject, days, who):
    return {"topic_id": tid, "subject": subject, "updated_at": stamp(days),
            "messages": [{"created_at": stamp(days),
                          "creator": {"id": who, "email_address": who, "name": "News"}}]}

if args[0] == "search":
    if "--json" not in args:
        sys.stderr.write("stub: search wants --json\n")
        sys.exit(2)
    data = []
    query = next((a for a in args[1:] if not a.startswith("--") and a not in
                  (flag("--from"), flag("--to"), flag("--date"))), "")
    if flag("--to") == "news@example.com":
        data = [thread("18c0a1b2c3d4e5f2", "Gmail sent reply", 4, "me@example.com")]
    elif query == "news@example.com":
        data = [thread("18c0a1b2c3d4e5f0", "Gmail alpha", 3, "news@example.com"),
                thread("18c0a1b2c3d4e5f3", "Gmail mentioned", 6, "other@example.org")]
    elif flag("--from") == "news@example.com":
        data = [thread("18c0a1b2c3d4e5f0", "Gmail alpha", 3, "news@example.com"),
                thread("18c0a1b2c3d4e5f1", "Gmail beta", 10, "news@example.com"),
                thread("18c0a1b2c3d4e5f4", "Gmail ancient", 40, "news@example.com")]
    out({"ok": True, "data": data})
    sys.exit(0)
if args[:2] == ["thread", "read"]:
    print("stub-gmail-thread " + args[2])
    sys.exit(0)
if args[:2] == ["attachment", "list"]:
    out({"ok": True, "data": [{"id": args[2] + ".att1", "filename": "note.txt"}]})
    sys.exit(0)
if args[:2] == ["attachment", "save"]:
    dest = flag("--output")
    os.makedirs(dest, exist_ok=True)
    target = os.path.join(dest, "note.txt")
    if os.path.exists(target) and "--force" not in args:
        sys.stderr.write("destination already exists: %s\n" % target)
        sys.exit(64)
    with open(target, "w") as f:
        f.write("stub-gmail-attachment\n")
    sys.exit(0)
if args[:2] == ["draft", "list"]:
    out({"ok": True, "data": [
        {"id": "r-1234abcd", "subject": "Gmail draft", "updated_at": stamp(1),
         "addressed_contacts": [{"email_address": "news@example.com"}]},
        {"id": "r-9999ffff", "subject": "Other gmail draft", "updated_at": stamp(1),
         "addressed_contacts": [{"email_address": "someone@example.org"}]}]})
    sys.exit(0)
if args[:2] == ["draft", "show"]:
    if args[2] != "r-1234abcd":
        sys.stderr.write("stub: no such draft\n")
        sys.exit(1)
    out({"ok": True, "data": {"id": "r-1234abcd", "subject": "Gmail draft", "from": "me@example.com",
                              "to": ["news@example.com"], "cc": [], "bcc": ["hidden@example.org"],
                              "body": "stub-gmail-draft-body"}})
    sys.exit(0)
sys.stderr.write("gmail-stub: unexpected call: %s\n" % " ".join(args))
sys.exit(2)
EOF
  chmod 700 "$root/bin/finger-touch" "$root/libexec/hey" "$root/bin/finger-seal" "$root/lib/providers/gmail.py"
}

make_root() {
  ROOT="$(trap - EXIT; mktemp -d /tmp/fingeronit-ux.XXXXXX)"
  case "$ROOT" in
    /tmp/fingeronit-ux.*) ;;
    *) printf 'ux-test: refused to use %s\n' "$ROOT" >&2; exit 1 ;;
  esac
  mkdir -p "$ROOT/bin" "$ROOT/lib/providers" "$ROOT/libexec" "$ROOT/var/live" "$ROOT/var/instances"
  cp "$SRC" "$ROOT/bin/fingeronit"
  cp "$KEEPER_SRC" "$ROOT/lib/keeper"
  cp "$HERE/../lib/job.py" "$ROOT/lib/job.py"
  chmod 700 "$ROOT/lib/keeper"
  chmod 700 "$ROOT/bin/fingeronit"
  ln -s bin/fingeronit "$ROOT/fingeronit"
  write_stubs "$ROOT"
  write_drive "$ROOT/drive.py"
  [[ -f "$ROOT/drive.py" ]] || { printf 'ux-test: drive.py missing in %s\n' "$ROOT" >&2; exit 1; }
  ROOTS+=("$ROOT")
}

write_drive() {
  cat > "$1" << 'PY'
import os, select, subprocess, sys, time

def text_of(buf):
    return buf.decode("utf-8", "replace").replace("\r", "")

def dump(buf):
    lines = text_of(buf).splitlines()
    sys.stderr.write("\n".join(lines[-80:]) + "\n")

def wait_child(pid, fd, buf, deadline):
    while time.time() < deadline:
        r, _, _ = select.select([fd], [], [], 0.2)
        if r:
            try:
                chunk = os.read(fd, 8192)
            except OSError:
                chunk = b""
            if chunk:
                buf += chunk
                continue
        wpid, status = os.waitpid(pid, os.WNOHANG)
        if wpid != 0:
            return buf, os.waitstatus_to_exitcode(status)
    os.kill(pid, 15)
    for _ in range(30):
        if os.waitpid(pid, os.WNOHANG)[0] != 0:
            break
        time.sleep(0.1)
    else:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
    dump(buf)
    raise SystemExit("timed out waiting for exit")

def read_until(pid, fd, buf, pos, want, deadline):
    needle = want.encode()
    while needle not in buf[pos:] and time.time() < deadline:
        r, _, _ = select.select([fd], [], [], 0.2)
        if not r:
            wpid, _ = os.waitpid(pid, os.WNOHANG)
            if wpid != 0:
                dump(buf)
                raise SystemExit("exited before seeing " + want)
            continue
        try:
            chunk = os.read(fd, 8192)
        except OSError:
            chunk = b""
        if not chunk:
            dump(buf)
            raise SystemExit("closed before seeing " + want)
        buf += chunk
    if needle not in buf[pos:]:
        dump(buf)
        raise SystemExit("timed out waiting for " + want)
    idx = buf.find(needle, pos)
    return buf, idx, text_of(buf[pos:idx])

def drive(root, args, steps, timeout):
    pid, fd = os.forkpty()
    if pid == 0:
        os.chdir(root)
        os.execv(root + "/fingeronit", [root + "/fingeronit", *args])
    buf = b""
    pos = 0
    deadline = time.time() + timeout
    try:
        for step in steps:
            buf, idx, slice_ = read_until(pid, fd, buf, pos, step["wait"], deadline)
            pos = idx + len(step["wait"])
            if "check" in step:
                step["check"](root, slice_)
            if "send" in step:
                os.write(fd, step["send"].encode())
            if step.get("hangup"):
                # The terminal goes away, the way a crashed Terminal.app does.
                os.close(fd)
                end = time.time() + 20
                while time.time() < end:
                    done, status = os.waitpid(pid, os.WNOHANG)
                    if done:
                        return (os.waitstatus_to_exitcode(status), text_of(buf))
                    time.sleep(0.1)
                raise AssertionError("fingeronit did not exit after the terminal hung up")
        buf, code = wait_child(pid, fd, buf, deadline)
    except Exception:
        try:
            os.kill(pid, 15)
            os.waitpid(pid, 0)
        except OSError:
            pass
        raise
    return code, text_of(buf)

def must(cond, message):
    if not cond:
        raise SystemExit(message)

def live_lock(root):
    return os.path.isdir(os.path.join(root, "var/live/lock"))

def live_cred(root):
    return any(os.path.exists(os.path.join(root, base, cfg, "credentials.json"))
               for base in ("var/live/keeper/door/xdg", "var/live/xdg")
               for cfg in ("hey-cli", "fingeronit-gmail"))

def door(root, name):
    return os.path.join(root, "var/live/keeper/door", name)

def keeper(root, args, stdin):
    import subprocess
    env = dict(os.environ, FINGERONIT_KEEPER_HOME=os.path.join(root, "var/live/keeper"),
               FINGERONIT_KEEPER_HEY=os.path.join(root, "libexec/hey"),
               FINGERONIT_KEEPER_GMAIL=os.path.join(root, "lib/providers/gmail.py"),
               FINGERONIT_KEEPER_SEAL=os.path.join(root, "bin/finger-seal"))
    p = subprocess.run(["/bin/bash", os.path.join(root, "lib/keeper")] + args, input=stdin.encode(),
                       capture_output=True, env=env, start_new_session=True)
    return p.returncode, (p.stdout + p.stderr).decode("utf-8", "replace")

def outsider_refused(root):
    # An agent running as you, with no ticket and no share of this terminal.
    code, out = keeper(root, ["run", "--", "box", "list"], "not-the-ticket\n")
    must(code == 77 and "does not hold the open door" in out, "keeper ran hey without the ticket: %s %s" % (code, out))
    code, out = keeper(root, ["save", "1110:1"], "\n")
    must(code == 77, "keeper saved an attachment without the ticket")
    # Even with the ticket in hand (readable here only because the test keeper
    # runs as you), another terminal is turned away.
    ticket = open(door(root, "ticket")).read()
    code, out = keeper(root, ["run", "--", "box", "list"], ticket)
    must(code == 77 and "another terminal" in out, "keeper ran hey for another terminal: %s %s" % (code, out))
    must("hey-stub" not in out, "hey ran for an outsider")

def seal(root):
    return os.path.isfile(os.path.join(root, "var/instances/temp/sealed.box"))

PAUSE = "for the menu."

def out_sealed(root, slice_):
    must("Sealed. The door is shut." in slice_, "missing seal confirmation")
    must(not live_lock(root), "door left open after sign-in")
    must(not live_cred(root), "credential left in the open after sign-in")
    must(seal(root), "seal file missing after sign-in")

def menu_locked(root, slice_):
    must("Locked." in slice_, "menu did not say locked")
    must("seal" in slice_ and "yes" in slice_, "menu did not show seal yes")
    must("door" in slice_ and "shut" in slice_, "menu did not show door shut")
    must("Export mail from a sender" in slice_, "export was not offered")
    must("Browse mail" in slice_, "browse was not offered")
    must("0  Quit" in slice_, "quit row missing")

def menu_fresh(root, slice_):
    must("Sign in" in slice_, "sign-in was not offered")
    must("Open a shell session" not in slice_, "session offered before sign-in")
    must("Export mail from a sender" not in slice_, "export offered before sign-in")
    must("No login yet" in slice_, "fresh box did not say so")

def assert_nothing(root, slice_):
    must("Nothing run." in slice_, "empty command was silent")
    must(not live_lock(root), "empty command opened the door")

def assert_version(root, slice_):
    must("hey version stub" in slice_, "version did not run")
    must(not live_lock(root), "version opened the door")

def assert_box(root, slice_):
    must("hey-stub: box list" in slice_, "command did not run")
    must("Done. The door is shut." in slice_, "command did not shut the door")
    must(not live_lock(root), "command left the door open")
    must(not live_cred(root), "command left a live credential")
    must(seal(root), "command lost the seal")

def assert_tui(root, slice_):
    must("hey-stub: tui" in slice_, "browse did not start the tui")
    must("Done. The door is shut." in slice_, "browse did not shut the door")
    must(not live_lock(root) and not live_cred(root), "browse left the door open")

def assert_help(root, slice_):
    must("What the lock is" in slice_, "help screen missing")
    must("space ticks" in slice_, "help keys missing")

def assert_session(root, slice_):
    must("Session closed. The door is shut." in slice_, "session did not close")
    must("door" in slice_ and "shut" in slice_, "menu door not shut after session")
    must(not live_lock(root), "session left the door open")
    must(not live_cred(root), "session left a live credential")
    must(seal(root), "session lost the seal")

def assert_kept(root, slice_):
    must("left it alone" in slice_, "bad destroy confirmation was not refused")
    must(seal(root), "bad confirmation removed the seal")

def assert_destroyed(root, slice_):
    must("Destroyed instance" in slice_, "destroy did not finish")
    must(not seal(root), "seal file survived destroy")
    must(not live_lock(root), "destroy left the door open")

def signin(root):
    steps = [
        {"wait": "Choose:", "check": menu_fresh, "send": "1"},
        {"wait": "Provider [1 HEY, 2 Gmail]", "send": "\n"},
        {"wait": PAUSE, "check": out_sealed, "send": " "},
        {"wait": "Choose:", "check": menu_locked, "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 20)
    must(code == 0, "signin exit %s" % code)
    must("Door shut." in all_text, "signin quit did not shut")

def story(root):
    # Locked menu: 1 export, 2 browse, 3 run, 4 session, 5 switch, 6 destroy, 7 help
    steps = [
        {"wait": "Choose:", "check": menu_fresh, "send": "1"},
        {"wait": "Provider [1 HEY, 2 Gmail]", "send": "\n"},
        {"wait": PAUSE, "check": out_sealed, "send": " "},
        {"wait": "Choose:", "check": menu_locked, "send": "3"},
        {"wait": "hey > ", "send": "\n"},
        {"wait": "Choose:", "check": assert_nothing, "send": "3"},
        {"wait": "hey > ", "send": 'search --from "Jane Doe\n'},
        {"wait": "Choose:", "check": lambda root, sl: must("quote left open" in sl, "open quote was not explained"), "send": "3"},
        {"wait": "hey > ", "send": "version\n"},
        {"wait": PAUSE, "check": assert_version, "send": " "},
        {"wait": "Choose:", "send": "3"},
        {"wait": "hey > ", "send": "hey box list\n"},
        {"wait": PAUSE, "check": assert_box, "send": " "},
        {"wait": "Choose:", "send": "2"},
        {"wait": PAUSE, "check": assert_tui, "send": " "},
        {"wait": "Choose:", "send": "\x1b[B\x1b[B"},
        {"wait": "> 4", "send": "\r"},
        {"wait": "Session temp is open", "send": "exit\n"},
        {"wait": "Choose:", "check": assert_session, "send": "?"},
        {"wait": PAUSE, "check": assert_help, "send": " "},
        {"wait": "Choose:", "send": "5"},
        {"wait": "Switch to", "send": "\n"},
        {"wait": "Choose:", "check": lambda root, sl: must("Still on temp." in sl, "switch note missing"), "send": "9"},
        {"wait": "Choose:", "check": lambda root, sl: must("No choice 9." in sl, "bad number was silent"), "send": "6"},
        {"wait": "Type DESTROY:", "send": "NO\n"},
        {"wait": PAUSE, "check": assert_kept, "send": " "},
        {"wait": "Choose:", "send": "6"},
        {"wait": "Type DESTROY:", "send": "DESTROY\n"},
        {"wait": PAUSE, "check": assert_destroyed, "send": " "},
        {"wait": "Choose:", "check": lambda root, sl: (
            menu_fresh(root, sl),
            must("updated on disk" not in sl, "false updated-on-disk notice"),
            os.utime(os.path.join(root, "bin/fingeronit"), None),
            os.utime(os.path.join(root, "bin/fingeronit"), (os.path.getmtime(os.path.join(root, "bin/fingeronit")) + 5,) * 2),
        ), "send": "r"},
        {"wait": "Choose:", "check": lambda root, sl: must("updated on disk" in sl, "an edited fingeronit was not noticed"), "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 60)
    must(code == 0, "story exit %s" % code)
    must("Door shut." in all_text, "quit did not say the door is shut")

def already(root):
    code, all_text = drive(root, ["login"], [], 10)
    must(code == 1, "second login exit %s" % code)
    must("already has a seal" in all_text, "second login did not refuse")
    must(seal(root), "second login removed the seal")
    must(not live_lock(root), "second login opened the door")

def setup_refused(root):
    code, all_text = drive(root, ["run", "--", "setup"], [], 10)
    must(code == 1, "setup exit %s" % code)
    must("refused" in all_text, "setup was not refused")
    must(not live_lock(root), "refused setup opened the door")

def version_cmd(root):
    code, all_text = drive(root, ["run", "--", "version"], [], 10)
    must(code == 0, "version exit %s" % code)
    must("hey version stub" in all_text, "direct version failed")
    must(not live_lock(root), "direct version opened the door")

def stale(root):
    steps = [
        {"wait": "Choose:", "check": lambda root, sl: (
            must("stale" in sl, "stale door not shown"),
            must("Reseal the crashed session" in sl, "reseal not offered"),
            must("Open a shell session" not in sl, "session offered while stale"),
        ), "send": "q"},
        {"wait": "Choose:", "check": lambda root, sl: must(
            "Reseal before you quit" in sl, "quit was allowed while stale"
        ), "send": "1"},
        {"wait": PAUSE, "check": lambda root, sl: (
            must("Resealed. The door is shut." in sl, "reseal did not confirm"),
            must(not live_lock(root), "reseal left the lock"),
            must(not live_cred(root), "reseal left a live credential"),
        ), "send": " "},
        {"wait": "Choose:", "check": lambda root, sl: must(
            "door" in sl and "shut" in sl, "door not shut after reseal"
        ), "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 20)
    must(code == 0, "stale exit %s" % code)
    must("Door shut." in all_text, "stale quit did not shut")

def assert_subjects(root, slice_):
    must("Alpha note" in slice_, "alpha missing from the list")
    must("Beta note" in slice_, "beta missing from the list")
    must("Gamma note" not in slice_, "mail older than 14 days was listed")
    must("Ancient note" not in slice_, "old mail was listed")
    must("Delta note" in slice_, "a thread only on the contact's list was missed")
    must("Contact old note" not in slice_, "the contact's old thread ignored the days window")
    must(slice_.count("Alpha note") == 1, "a thread in both lists was listed twice")
    must("a selects all" in slice_, "select-all hint missing")
    must("news@example.com" in slice_, "sender missing from the list")
    logp = os.path.join(root, "var/live/keeper/door/tmp/invocations.log")
    must(os.path.isfile(logp), "search was not recorded")
    log = open(logp, encoding="utf-8").read()
    must("--from news@example.com" in log, "from address was not passed")
    must("last_30_days" in log, "date bucket was not last_30_days")
    must("--all" in log, "search did not walk pages")
    must("summary" not in log, "a body field was requested")
    must("--json" in log, "search did not ask for json")
    must("contact threads 42 --all --json" in log, "the sender's thread list was not read")
    must("contact list" not in log, "listed contacts although search named the sender")
    for dirpath, _, files in os.walk(os.path.join(root, "var")):
        for name in files:
            data = open(os.path.join(dirpath, name), "rb").read()
            must(b"SECRET-BODY" not in data, "a message summary was written to " + name)

def assert_one_export(root, slice_, dest):
    must("Exported 1 thread." in slice_, "export count missing")
    must("The door is shut." in slice_, "door message missing")
    must("PDF:" in slice_, "pdf path missing")
    must(not live_lock(root), "export left the door open")
    must(not live_cred(root), "export left a credential")
    must(seal(root), "export lost the seal")
    md = os.path.join(dest, "past-14-days.md")
    pdf = os.path.join(dest, "past-14-days.pdf")
    must(os.path.isfile(md), "markdown missing")
    must(os.path.isfile(pdf), "pdf missing")
    must(open(pdf, "rb").read(5) == b"%PDF-", "pdf header missing")
    text = open(md, encoding="utf-8").read()
    must("stub-thread 222" in text, "selected thread missing")
    must("stub-thread 111" not in text, "unticked thread was written")
    must("stub-thread 333" not in text and "stub-thread 444" not in text, "old thread was written")
    must("Beta note" in text, "selected subject missing")
    must("Alpha note" not in text, "unticked subject was written")
    must(os.path.isfile(os.path.join(dest, "attachments", "222", "note.txt")), "attachment missing")
    must(os.path.isfile(os.path.join(dest, "attachments", "222", "note (2).txt")), "a different same-named file was lost")
    must(not os.path.exists(os.path.join(dest, "attachments", "222", "note (3).txt")), "an identical repeat was kept")
    must(not os.path.exists(os.path.join(dest, "attachments", "222", ".fingeronit-stage")), "the staging folder was left behind")
    must("Attachments: 2 saved, 1 identical repeats skipped." in slice_, "attachment counts missing")
    must("destination already exists" not in slice_, "hey's overwrite error reached the screen")
    must("note.txt" in text, "attachment name missing")
    must(not os.path.isdir(os.path.join(root, "var/live/tmp")), "hit list was not shredded")

def assert_all_export(root, slice_, dest):
    must("Exported 3 threads." in slice_, "select-all count missing")
    must("The door is shut." in slice_, "door message missing")
    must(not live_lock(root) and not live_cred(root), "select-all left the door open")
    must(seal(root), "select-all lost the seal")
    text = open(os.path.join(dest, "past-14-days.md"), encoding="utf-8").read()
    must("stub-thread 111" in text and "stub-thread 222" in text, "select-all missed a thread")
    must("stub-thread 333" not in text and "stub-thread 444" not in text, "select-all wrote an old thread")
    must("Alpha note" in text and "Beta note" in text, "select-all missed a subject")

def export_pick(root):
    dest = "/tmp/fingeronit-export." + os.path.basename(root)
    os.makedirs(dest, 0o700)
    steps = [
        {"wait": "Choose:", "send": "1"},
        {"wait": "Provider [1 HEY, 2 Gmail]", "send": "\n"},
        {"wait": PAUSE, "check": out_sealed, "send": " "},
        {"wait": "Choose:", "check": menu_locked, "send": "1"},
        {"wait": "news@example.com", "check": lambda root, sl: must(
            "Address (example:" in sl, "example sender missing"
        ), "send": "news@example.com\n"},
        {"wait": "with drafts]", "check": lambda root, sl: must(
            "2 to and from" in sl, "the to-and-from choice is missing"
        ), "send": "1\n"},
        {"wait": "Days back", "send": "14\n"},
        {"wait": "File [", "send": "3\n"},
        {"wait": "news-example.com", "check": lambda root, sl: must(
            "/fingeronit-export/" in sl and "Documents" not in sl, "default folder is not ~/fingeronit-export"
        ), "send": dest + "\n"},
        {"wait": "q cancels", "check": assert_subjects, "send": "\x1b[B"},
        {"wait": "q cancels", "send": " "},
        {"wait": "[*]", "send": "\n"},
        {"wait": PAUSE, "check": lambda root, sl: (
            assert_one_export(root, sl, dest),
            must("o opens the folder" in sl, "finder hint missing"),
        ), "send": " "},
        {"wait": "Choose:", "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 40)
    must(code == 0, "export exit %s" % code)
    must("Door shut." in all_text, "export quit did not shut")

