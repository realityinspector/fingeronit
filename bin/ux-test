def autopilot(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-home"
    os.makedirs(home, 0o700)
    os.environ["HOME"] = home
    os.environ["FINGERONIT_NO_OPEN"] = "1"
    dest = os.path.join(home, "fingeronit-export/news-example.com")
    def files_there(root, sl):
        must("Found 3:" in sl, "autopilot did not list the three recent threads")
        must("Alpha note" in sl and "Beta note" in sl, "autopilot subjects missing")
        must("Exported 3 threads." in sl, "autopilot count missing")
        must("deleted when fingeronit closes" in sl, "export did not warn the folder is temporary")
        text = open(os.path.join(dest, "past-14-days.md"), encoding="utf-8").read()
        must("stub-thread 111" in text and "stub-thread 222" in text and "stub-thread 555" in text, "autopilot missed a thread")
        must("Gamma note" not in text, "autopilot wrote an old thread")
        must(open(os.path.join(dest, "past-14-days.pdf"), "rb").read(5) == b"%PDF-", "autopilot pdf missing")
        must(os.path.isfile(os.path.join(dest, "attachments", "111", "note.txt")), "attachment was not saved")
        must(not live_lock(root) and not live_cred(root), "autopilot left the door open")
    steps = [
        {"wait": "Move anything you want to keep out of it now.", "check": files_there, "send": "\x03"},
        {"wait": "Ctrl-C does not skip this", "check": lambda root, sl: must(
            os.path.isdir(dest), "Ctrl-C deleted the exports without asking"), "send": "d"},
        {"wait": "Deleted"},
    ]
    code, all_text = drive(root, ["--autopilot-test"], steps, 30)
    must(code in (0, 130), "autopilot exit %s\n%s" % (code, all_text))
    must(not os.path.exists(os.path.join(home, "fingeronit-export")), "the export folder survived the farewell")

def two_senders(root):
    home = "/tmp/fingeronit-export." + os.path.basename(root) + "-two"
    os.makedirs(home, 0o700)
    os.environ["HOME"] = home
    os.environ["FINGERONIT_NO_OPEN"] = "1"
    args = ["export", "--from", "first@example.com", "--from", "second@example.org", "--all-time", "--md"]
    dest = os.path.join(home, "fingeronit-export/first-example.com-second-example.org")
    md = os.path.join(dest, "all-time.md")
    keep = {}
    def grab(root, sl):
        keep["text"] = open(md, encoding="utf-8").read()
        keep["pdf"] = os.path.exists(os.path.join(dest, "all-time.pdf"))
        must("Documents" not in sl and "older exports" not in sl, "a legacy export folder was listed")
    steps = [{"wait": "d   done", "check": grab, "send": "d"}, {"wait": "Deleted"}]
    code, all_text = drive(root, args, steps, 30)
    must(code == 0, "two-sender exit %s\n%s" % (code, all_text))
    must("Found 5:" in all_text, "two senders did not merge to 5 threads\n" + all_text)
    must("Exported 5 threads." in all_text, "two-sender count missing")
    text = keep["text"]
    must(text.count("## Shared thread") == 1, "shared thread was not deduped")
    must("First via contact" in text, "the contact-list fallback missed a thread")
    must("First ancient" in text, "all-time dropped an old thread")
    must("Mail from first@example.com or second@example.org" in text, "header missing both senders")
    must(not keep["pdf"], "--md wrote a pdf")
    log = open(os.path.join(root, "var/instances/temp/audit.log"), encoding="utf-8").read()
    must("export" in log, "export was not audited")
    must(not live_lock(root) and not live_cred(root), "two-sender export left the door open")

def idle_session(root):
    os.environ["FINGERONIT_IDLE_SECONDS"] = "4"
    steps = [
        {"wait": "Choose:", "send": "1"},
        {"wait": "Provider [1 HEY, 2 Gmail]", "send": "\n"},
        {"wait": PAUSE, "send": " "},
        {"wait": "Choose:", "send": "4"},
        {"wait": "closes itself after 4 seconds", "check": lambda root, sl: must(live_lock(root), "session did not open")},
        {"wait": "with no keys pressed. Closing the door."},
        {"wait": "Choose:", "check": assert_session, "send": "q"},
    ]
    code, _ = drive(root, [], steps, 40)
    must(code == 0, "idle session exit %s" % code)

