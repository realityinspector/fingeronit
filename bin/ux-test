    must(not any(n.startswith("hey-cli") for n in names), "a hey-cli folder was sealed for gmail")
    out = subprocess.run([root + "/fingeronit", "status"], capture_output=True, text=True).stdout
    must("provider  Gmail" in out, "status did not show Gmail")

def login_cli(root):
    bad = "/tmp/fingeronit-client." + os.path.basename(root) + ".bad.json"
