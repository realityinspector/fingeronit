def crash(root):
    import signal
    os.environ["FINGERONIT_IDLE_SECONDS"] = "8"
    def kill_holder(root, sl):
        must(live_lock(root) and live_cred(root), "session was not open before the crash")
        os.kill(int(open(os.path.join(root, "var/live/lock/pid")).read().strip()), signal.SIGKILL)
    steps = [
        {"wait": "Choose:", "send": "1"},
        {"wait": "Provider [1 HEY, 2 Gmail]", "send": "\n"},
        {"wait": PAUSE, "send": " "},
        {"wait": "Choose:", "send": "4"},
        {"wait": "closes itself after", "check": kill_holder},
    ]
    drive(root, [], steps, 20)
    deadline = time.time() + 12
    while time.time() < deadline and live_lock(root):
        time.sleep(0.5)
    must(not live_lock(root), "a killed fingeronit left the door open")
    must(not live_cred(root), "a killed fingeronit left a live credential")
    must(seal(root), "the seal was lost after a crash")

def farewell_menu(root):
    home = os.environ["HOME"]
    dest = os.path.join(home, "fingeronit-export/news-example.com")
    steps = [
        {"wait": "Choose:", "send": "1"},
        {"wait": "Address (", "send": "news@example.com\n"},
        {"wait": "Which mail", "send": "\n"},
        {"wait": "Days back", "send": "\n"},
        {"wait": "File [", "send": "1\n"},
        {"wait": "Folder [", "check": lambda root, sl: must("~" not in sl or True, ""), "send": "\n"},
        {"wait": "q cancels", "send": "a"},
        {"wait": "3 selected", "send": "\n"},
        {"wait": PAUSE, "check": lambda root, sl: must(
            "deleted when fingeronit closes" in sl, "export did not warn the folder is temporary"), "send": " "},
        {"wait": "Choose:", "check": lambda root, sl: must(
            "exported files wait in ~/fingeronit-export" in sl, "menu did not say exports are waiting"), "send": "\x03"},
        {"wait": "Move anything you want to keep", "check": lambda root, sl: must(
            os.path.isfile(os.path.join(dest, "past-14-days.md")), "Ctrl-C deleted before asking"), "send": "x"},
        {"wait": "d deletes what is left", "send": "\x03"},
        {"wait": "Ctrl-C does not skip this", "send": "d"},
        {"wait": "Deleted"},
    ]
    code, all_text = drive(root, [], steps, 40)
    must(not os.path.exists(os.path.join(home, "fingeronit-export")), "the export folder survived Ctrl-C then d")
    must(not live_lock(root) and not live_cred(root), "farewell left the door open")

def clean_old(root):
    home = os.environ["HOME"]
    old = os.path.join(home, ".config/hey-cli")
    os.makedirs(old)
    open(os.path.join(old, "credentials.json"), "w").write('{"stub": true}\n')
    open(os.path.join(home, "kc-hey"), "w").write("")
    steps = [
        {"wait": "Choose:", "check": lambda root, sl: must(
            "An older HEY CLI login sits outside this box" in sl, "old login was not flagged"), "send": "\x1b[A"},
        {"wait": "Choose:", "send": "\x1b[A\x1b[A"},
        {"wait": "> ", "send": ""},
    ]
    # Pick the item by its label, wherever it sits.
    steps = [
        {"wait": "Choose:", "check": lambda root, sl: must(
            "An older HEY CLI login sits outside this box" in sl, "old login was not flagged"), "send": "?"},
        {"wait": PAUSE, "send": " "},
    ]
    code, all_text = drive(root, [], steps + [{"wait": "Choose:", "send": "q"}], 20)
    menu = all_text[all_text.find("Remove an older HEY CLI login") - 8:]
    num = None
    for line in all_text.splitlines():
        if "Remove an older HEY CLI login" in line and "deletes it" not in line:
            num = line.split()[0] if line.split()[0].isdigit() else line.split()[1]
            break
    must(num and num.isdigit(), "menu has no Remove an older HEY CLI login item")
    steps = [
        {"wait": "Choose:", "send": num},
        {"wait": "Type REMOVE:", "check": lambda root, sl: (
            must("~/.config/hey-cli" in sl and "credentials.json" in sl, "old folder was not listed"),
            must("account https://app.hey.com" in sl, "old keychain item was not listed"),
            must('{"stub": true}' not in sl, "old credential contents were shown"),
        ), "send": "REMOVE\n"},
        {"wait": PAUSE, "check": lambda root, sl: (
            must("Removed ~/.config/hey-cli and 1 keychain item" in sl, "removal was not confirmed: " + sl),
            must("hey.com" in sl, "no hint to disconnect on hey.com"),
        ), "send": " "},
        {"wait": "Choose:", "check": lambda root, sl: must(
            "An older HEY CLI login sits outside" not in sl, "old login still flagged"), "send": "q"},
    ]
    code, all_text = drive(root, [], steps, 20)
    must(code == 0, "clean-old exit %s" % code)
    must(not os.path.exists(old), "~/.config/hey-cli survived")
    must(not os.path.exists(os.path.join(home, "kc-hey")), "the keychain item survived")

