make_root
root="$ROOT"
dead=999999
if kill -0 "$dead" 2>/dev/null; then
  printf 'ux-test: pid %s is alive, cannot plant a stale lock\n' "$dead" >&2
  exit 1
fi
door="$root/var/live/keeper/door"
mkdir -p "$root/var/live/lock" "$door/xdg/hey-cli" "$door/pids" "$root/var/instances/temp"
printf '%s\n' "$dead" > "$root/var/live/lock/pid"
printf '%s\n' temp > "$root/var/live/lock/instance"
printf '%s\n' /dev/ttys000 > "$root/var/live/lock/tty"
dd if=/dev/zero of="$door/key" bs=32 count=1 2>/dev/null
shasum -a 256 "$door/key" | cut -d' ' -f1 > "$root/var/instances/temp/key.sha256"
printf '%s\n' '{"origin":"test","fresh":true}' > "$door/xdg/hey-cli/credentials.json"
printf 'temp\n' > "$door/instance"
printf '/dev/ttys000\n' > "$door/tty"
printf 'deadbeef\n' > "$door/ticket"
printf 'FINGER1\0old\n' > "$root/var/instances/temp/sealed.box"
python3 "$root/drive.py" "$root" stale
[[ ! -e "$door" ]] || { printf 'ux-test: the keeper door survived the reseal\n' >&2; exit 1; }
tail -c +9 "$root/var/instances/temp/sealed.box" | tar -xzO hey-cli/credentials.json | grep -q '"fresh":true' \
  || { printf 'ux-test: the reseal did not save what the keeper held\n' >&2; exit 1; }
pass "a crashed session must be resealed before quit, and the keeper's copy is what gets sealed"

make_root
root="$ROOT"
door="$root/var/live/keeper/door"
mkdir -p "$door/xdg/hey-cli" "$root/var/instances/temp"
dd if=/dev/urandom of="$door/key" bs=32 count=1 2>/dev/null
dd if=/dev/zero bs=32 count=1 2>/dev/null | shasum -a 256 | cut -d' ' -f1 > "$root/var/instances/temp/key.sha256"
printf '%s\n' '{"planted":true}' > "$door/xdg/hey-cli/credentials.json"
printf 'temp\n' > "$door/instance"
